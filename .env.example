# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/endoexpert
# Set to true if your host requires SSL (it is auto-enabled in production for non-local databases)
# DATABASE_SSL=true

# Long random string used to sign admin login tokens (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created on server start if no user with this email exists
ADMIN_EMAIL=admin@example.com
# Quote values that contain # or spaces, e.g. ADMIN_PASSWORD='my#pass word'
ADMIN_PASSWORD=change-me-please

# Optional (default 4000)
# PORT=4000
